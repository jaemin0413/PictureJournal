{
  "name": "picture-journal-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test src/mobile-runtime.test.mjs",
    "web:export": "npx expo export --platform web --output-dir dist-web",
    "android:prebuild": "npx expo prebuild --platform android --no-install --clean",
    "ios:prebuild": "npx expo prebuild --platform ios --no-install --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.39",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-image-picker": "~15.0.7",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-share-intent": "^2.7.0",
    "expo-splash-screen": "^0.27.7",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.12"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "patch-package": "^8.0.1",
    "sax": "^1.6.0",
    "typescript": "~5.3.3"
  }
}
